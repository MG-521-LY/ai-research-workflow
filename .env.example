# This file lists environment variable names only. The programs read process
# environment variables; copying this file alone does not load them.
DEEPSEEK_API_KEY=
ANTIGRAVITY_LOCAL_API_KEY=
# Set only when using the optional local DSH controller.
AI_RESEARCH_ROOT=
DSH_EXECUTABLE=
# Zotero locations are user-specific. Do not commit real local configuration.
ZOTERO_DB=
ZOTERO_STORAGE=
# External official unpacked Connector; never point at a personal browser profile.
ZOTERO_CONNECTOR_EXTENSION=
ZOTERO_LOCAL_API_URL=
ZOTERO_LOCAL_API_KEY=

