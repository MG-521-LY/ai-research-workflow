      "api_key_env_var": "DEEPSEEK_API_KEY",
      "temperature": 0,
      "phase_status": "待接通"
    },
    "summary_llm": {
      "provider": "unconfigured_in_python_env",
      "model_name": "none_in_phase_a",
      "api_base": null,
      "api_key_env_var": "DEEPSEEK_API_KEY",
      "phase_status": "待接通"
    },
    "embedding": {
      "sparse_provider": "paperqa_native_and_tantivy",
      "sparse_model": "SparseEmbeddingModel_and_BM25",
      "remote_dense_model": null,
      "phase_status": "本地稀疏就绪 / 远程Dense未实测"
