{
  "version": "1.1.0",
  "task_id": "T003-PAPERQA-BRIDGE",
  "runtime": {
    "python_interpreter": ".venv/Scripts/python.exe",
    "allow_network_requests": false,
    "offline_mode_enforced": true,
    "litellm_local_model_cost_map": true,
    "hf_hub_offline": true
  },
  "models": {
